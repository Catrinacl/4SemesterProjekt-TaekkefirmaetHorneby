<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaekApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="logo.jpg"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="House with brand logo" />

            <Label
                Text="Tækkefirmaet Horneby"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Button
                x:Name="projekterOversigt"
                Text="Projektoversigt" 
                SemanticProperties.Hint="Leads you to the project overview"
                HorizontalOptions="Center" />

            <Button
                x:Name="opretProjekt"
                Text="Opret Projekt" 
                SemanticProperties.Hint="Leads you to page where you can create a new project"
                HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
