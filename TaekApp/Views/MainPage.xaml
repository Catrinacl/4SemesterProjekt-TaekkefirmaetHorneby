<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaekApp.Views.MainPage"
             Title="Oversigtskalender">
    <ScrollView>
        <Grid ColumnDefinitions="240, *">

        <!-- Menu -->
        <Border Grid.Column="0" BackgroundColor="#F0F0F0" StrokeThickness="0" Padding="20, 25">
            <VerticalStackLayout Spacing="15">
                <Label Text="TÆKKEFIRMAET HORNEBY" FontAttributes="Bold" FontSize="14" Margin="0,0,0,20" />

                <Button x:Name="btnProjektoversigt" Text="Projektoversigt" Clicked="OnProjekterOversigtClicked" BackgroundColor="#D0D0D0" TextColor="Black" />
                <Button x:Name="btnOpretProjekt" Text="+ Opret Projekt" Clicked="OnOpretProjektClicked" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" />
                <Button x:Name="btnOpretDagsprojekt" Text="+ Opret Dagsprojekt" Clicked="OnOpretDagsprojektClicked" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" />
                <Button x:Name="btnOpretArbejdsopgave" Text="+ Opret Arbejdsopgave" Clicked="OnOpretStandardArbejdsopgaveClicked" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" />


                    <!-- Skjulte knapper -->
                    <Button x:Name="btnOpretKunde" Text="+ Opret Kunde" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" IsVisible="False" />
                    <Button x:Name="btnOpretMedarbejder" Text="+ Opret Medarbejder" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" IsVisible="False" />


                    <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

                <Button x:Name="btnOversigtskalender" Text="Oversigtskalender" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Start" Clicked="OnOversigtskalenderClicked"/>
                <Button x:Name="btnMedarbejderoversigt" Text="Medarbejderoversigt" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Start" Clicked="OnMedarbejderoversigtClicked"/>
                <Button x:Name="btnKundeoversigt" Text="Kundeoversigt" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Start" Clicked="OnKundeoversigtClicked"/>

            </VerticalStackLayout>
        </Border>

        <!-- Kalenderen -->
        <Grid x:Name="KalenderContainer" Grid.Column="1" RowDefinitions="Auto, Auto, *" Padding="20">

            <!-- Navigation i toppen af kalenderen -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, *, Auto" Margin="0,0,0,15" VerticalOptions="Center">
                <Button Grid.Column="0" Text="◄" Clicked="OnPrevMonthClicked" WidthRequest="45" HeightRequest="35" Padding="0" Margin="0,0,5,0" />
                <Button Grid.Column="1" Text="►" Clicked="OnNextMonthClicked" WidthRequest="45" HeightRequest="35" Padding="0" Margin="0,0,10,0" />
                <Button Grid.Column="2" Text="I dag" Clicked="OnTodayClicked" HeightRequest="35" Padding="10,0" />

                <Label Grid.Column="3" x:Name="lblCurrentMonth" Text="November 2026" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" />

                <HorizontalStackLayout Grid.Column="4" Spacing="2">
                    <Button Text="Måned" HeightRequest="35" BackgroundColor="#2196F3" TextColor="White" FontAttributes="Bold" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Ugedage -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*" BackgroundColor="#E0E0E0" Padding="5,8">
                <Label Grid.Column="0" Text="Mandag" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
                <Label Grid.Column="1" Text="Tirsdag" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
                <Label Grid.Column="2" Text="Onsdag" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
                <Label Grid.Column="3" Text="Torsdag" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
                <Label Grid.Column="4" Text="Fredag" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
                <Label Grid.Column="5" Text="Lørdag" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" />
                <Label Grid.Column="6" Text="Søndag" HorizontalOptions="Center" FontAttributes="Bold" FontSize="12" Opacity="0.6" />
            </Grid>

            <!-- Månedsgitter -->
            <Grid x:Name="CalendarGrid" 
                  Grid.Row="2" 
                  ColumnDefinitions="*,*,*,*,*,*,*" 
                  BackgroundColor="#CCCCCC" 
                  RowSpacing="1" 
                  ColumnSpacing="1">
            </Grid>
        </Grid>

        <ContentView x:Name="IndholdsContainer" Grid.Column="1" IsVisible="False" />

        </Grid>
    </ScrollView>
</ContentPage>