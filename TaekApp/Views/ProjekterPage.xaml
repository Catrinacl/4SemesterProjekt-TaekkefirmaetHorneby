<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaekApp.Views.ProjekterPage">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="Projektoversigt"
            FontSize="28"
            FontAttributes="Bold" />

        <HorizontalStackLayout Grid.Row="1" Spacing="10">

            <Button
                Text="Projekter"
                Clicked="OnProjekterClicked" />

            <Button
                Text="Dagsprojekter"
                Clicked="OnDagsprojekterClicked" />

        </HorizontalStackLayout>

        <CollectionView
            x:Name="ProjekterListe"
            Grid.Row="2">

            <CollectionView.EmptyView>
                <Label Text="Der er ingen projekter endnu." />
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>

</ContentPage>