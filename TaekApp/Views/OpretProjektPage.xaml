<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaekApp.Views.OpretProjektPage"
             Title="Opret Projekt">
    <VerticalStackLayout>
        
        <Label 
            Text="ProjektID"
            VerticalOptions="Start" 
            HorizontalOptions="Start" />
        <Entry x:Name="projektInput" 
               Placeholder="Tilføj projektID" 
               Keyboard="Numeric"
               WidthRequest="200"/>

        <Label 
            Text="KundeID"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry x:Name="kundeIdInput" 
               Placeholder="Tilføj kundeID"
               Keyboard="Numeric"
               WidthRequest="200"/>

        <Label
            Text="Medarbejdere"
            VerticalOptions="Start" 
            HorizontalOptions="Start" />
        <Picker x:Name="MedListe"
                BackgroundColor="SlateGray"
                WidthRequest="200"
                FontSize="18"/>

        <Label
            Text="Adresse"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry x:Name="adresseInput" 
               Placeholder="Tilføj adresse"
               WidthRequest="200" />
        
         <Label
            Text="Status"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
          <Entry x:Name="statusInput" 
                 Placeholder="Tilføj status" 
                 WidthRequest="200"/>
            
         <Label
            Text="Forventet Varighed Timer"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
          <Entry x:Name="forventetVarighedInput" 
                 Placeholder="Tilføj varighed Timer"
                 Keyboard="Numeric"
                 WidthRequest="200" />
            
          <Label
            Text="Kvadratmeter af tag"
            VerticalOptions="Start"
            HorizontalOptions="Start"/>
            <Entry x:Name="kvadratMeterTagIndput" 
                   Placeholder="Tilføj varighed Timer"
                   Keyboard="Numeric" 
                   WidthRequest="200" />
            
            
        <Button
            Clicked="Button_Clicked"
            Text="Opret projekt"
            VerticalOptions="Start"
            HorizontalOptions="Start"
            WidthRequest="200" /> 
            
    </VerticalStackLayout>
    
</ContentPage>