<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaekApp.Views.ArbejdsopgaverPage">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="10">

        <Label Grid.Row="0"
               Text="Arbejdsopgaveoversigt"
               FontSize="24"
               FontAttributes="Bold" />

        <Grid Grid.Row="1"
              ColumnDefinitions="2*, 2*, 1*, 1*"
              BackgroundColor="#E6E2DD"
              Padding="10">
            <Label Grid.Column="0" Text="Navn" FontAttributes="Bold" />
            <Label Grid.Column="1" Text="Beskrivelse" FontAttributes="Bold" />
            <Label Grid.Column="2" Text="Enhed" FontAttributes="Bold" />
            <Label Grid.Column="3" Text="Svend/dag" FontAttributes="Bold" />
        </Grid>

        <CollectionView Grid.Row="2" x:Name="ArbejdsopgaverListe">

            <CollectionView.EmptyView>
                <Label Text="Der er ingen arbejdsopgaver endnu."
                       Padding="15"
                       TextColor="#555555" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="2*, 2*, 1*, 1*"
                              Padding="10">
                            <Label Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                   Text="{Binding Description}" />
                            <Label Grid.Column="2"
                                   Text="{Binding Unit}" />
                            <Label Grid.Column="3"
                                   Text="{Binding SvendProductionPerDay}" />
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="#E6E2DD" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentView>
