<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaekApp.Views.OpretDagsprojektPage"
             Title="Opret dagsprojekt"
             BackgroundColor="{StaticResource HornebyBeigeBg}">

    <ScrollView>
        <Border BackgroundColor="White"
                Stroke="{StaticResource HornebyOliveGreen}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="32"
                Margin="24"
                MaximumWidthRequest="720"
                HorizontalOptions="Fill"
                VerticalOptions="Start">

            <VerticalStackLayout Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Opret nyt dagsprojekt"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource HornebyDarkText}" />
                    <Label Text="Udfyld projektets oplysninger"
                           FontSize="13"
                           TextColor="{StaticResource HornebyDarkText}" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#E6E2DD" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Vælg kunde"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#4A4946" />
                    <Picker x:Name="KundeListe"
                            Title="Vælg en kunde"
                            BackgroundColor="#FAF9F6"
                            TextColor="#4A4946" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Adresse"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#4A4946" />
                    <Entry x:Name="AdresseEntry"
                           Placeholder="Indtast projektets adresse"
                           BackgroundColor="#FAF9F6"
                           TextColor="#4A4946" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Vælg medarbejdere"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#4A4946" />
                    <VerticalStackLayout x:Name="MedarbejderContainer"
                                         Spacing="8" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Status"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#4A4946" />
                    <Entry x:Name="StatusEntry"
                           Text="Fremtidigt projekt"
                           Placeholder="Indtast status"
                           BackgroundColor="#FAF9F6"
                           TextColor="#4A4946" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Tagareal (m²)"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#4A4946" />
                    <Entry x:Name="TagarealEntry"
                           Placeholder="Antal m²"
                           Keyboard="Numeric"
                           BackgroundColor="#FAF9F6"
                           TextColor="#4A4946" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Startdato"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#4A4946" />
                    <DatePicker x:Name="StartdatoPicker"
                                BackgroundColor="#FAF9F6"
                                TextColor="#4A4946" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#E6E2DD" />

                <VerticalStackLayout Spacing="10">
                    <Label Text="Vælg arbejdsopgaver"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource HornebyDarkText}" />
                    <Label Text="Vælg de arbejdsopgaver, der skal udføres."
                           FontSize="13"
                           TextColor="#4A4946" />
                    <VerticalStackLayout x:Name="ArbejdsopgaverContainer"
                                         Spacing="10" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#E6E2DD" />

                <Label Text="Projektberegning"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="#4A4946" />

                <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Forventet varighed (timer)"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#4A4946" />
                        <Entry x:Name="VarighedEntry"
                               Placeholder="Beregnes automatisk"
                               IsReadOnly="True"
                               BackgroundColor="#FAF9F6"
                               TextColor="#4A4946" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Beregnet slutdato"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#4A4946" />
                        <Entry x:Name="SlutdatoResultat"
                               Placeholder="Beregnes automatisk"
                               IsReadOnly="True"
                               BackgroundColor="#FAF9F6"
                               TextColor="#4A4946" />
                    </VerticalStackLayout>
                </Grid>

                <Button Text="Beregn dagsprojekt"
                        Clicked="OnBeregnDagsprojektClicked"
                        BackgroundColor="#77776A"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="42" />

                <Button x:Name="OpretDagsprojektButton"
                        Text="Opret dagsprojekt"
                        Clicked="OnOpretDagsprojektClicked"
                        IsEnabled="False"
                        BackgroundColor="{StaticResource HornebyOliveGreen}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="42" />

            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
