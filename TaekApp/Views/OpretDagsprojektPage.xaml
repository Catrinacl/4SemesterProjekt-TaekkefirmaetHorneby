<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaekApp.Views.OpretDagsprojektPage"
    Title="Opret dagsprojekt">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Opret dagsprojekt"
                FontSize="28"
                FontAttributes="Bold" />

            <Label Text="Adresse" />

            <Entry
                x:Name="AdresseEntry"
                Placeholder="Indtast projektets adresse" />

            <Label Text="Tagareal i m²" />

            <Entry
                x:Name="TagarealEntry"
                Placeholder="Indtast tagareal"
                Keyboard="Numeric" />

            <Button
                Text="Opret dagsprojekt"
                Clicked="OnOpretDagsprojektClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>