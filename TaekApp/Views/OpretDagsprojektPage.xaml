<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaekApp.Views.OpretDagsprojektPage"
    Title="Opret dagsprojekt"
    BackgroundColor="{StaticResource HornebyBeigeBg}">

    <ScrollView>
        <Border BackgroundColor="White"
                Stroke="{StaticResource HornebyOliveGreen}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="32"
                Margin="24"
                MaximumWidthRequest="720"
                HorizontalOptions="Fill"
                VerticalOptions="Start">

            <VerticalStackLayout Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Opret nyt dagsprojekt"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{StaticResource HornebyDarkText}" />
                    <Label Text="Udfyld data"
                        FontSize="13"
                        TextColor="{StaticResource HornebyDarkText}" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#E6E2DD" />

                <Label Text="Vælg kunde" />
                <Picker
                    x:Name="KundeListe"
                    Title="Vælg en kunde" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Adresse" FontAttributes="Bold" FontSize="13" TextColor="#4A4946" />
                    <Entry x:Name="AdresseEntry"
                           Placeholder="Indtast projektets adresse"
                           BackgroundColor="#FAF9F6"
                           TextColor="#4A4946" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Status" FontAttributes="Bold" FontSize="13" TextColor="#4A4946" />
                    <Entry x:Name="StatusEntry"
                           Text="Fremtidigt projekt"
                           Placeholder="Indtast status"
                           BackgroundColor="#FAF9F6"
                           TextColor="#4A4946" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Forventet varighed (timer)" FontAttributes="Bold" FontSize="13" TextColor="#4A4946" />
                        <Entry x:Name="VarighedEntry"
                               Placeholder="Antal timer"
                               Keyboard="Numeric"
                               BackgroundColor="#FAF9F6"
                               TextColor="#4A4946" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Tagareal (m²)" FontAttributes="Bold" FontSize="13" TextColor="#4A4946" />
                        <Entry x:Name="TagarealEntry"
                               Placeholder="Antal m²"
                               Keyboard="Numeric"
                               BackgroundColor="#FAF9F6"
                               TextColor="#4A4946" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Startdato" FontAttributes="Bold" FontSize="13" TextColor="#4A4946" />
                        <DatePicker x:Name="StartdatoPicker"
                                    BackgroundColor="#FAF9F6"
                                    TextColor="#4A4946" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Slutdato" FontAttributes="Bold" FontSize="13" TextColor="#4A4946" />
                        <DatePicker x:Name="SlutdatoPicker"
                                    BackgroundColor="#FAF9F6"
                                    TextColor="#4A4946" />
                    </VerticalStackLayout>
                </Grid>


                <VerticalStackLayout Spacing="10">

                    <Label Text="Vælg arbejdsopgaver"
           FontSize="18"
           FontAttributes="Bold"
           TextColor="{StaticResource HornebyDarkText}" />

                    <Label Text="Vælg de standardarbejdsopgaver, der skal udføres på projektet."
           FontSize="13"
           TextColor="#4A4946" />

                    <VerticalStackLayout x:Name="ArbejdsopgaverContainer"
                         Spacing="10" />

                </VerticalStackLayout>


                <BoxView HeightRequest="1" Color="#E6E2DD" Margin="0,6,0,0" />

                <HorizontalStackLayout HorizontalOptions="End" Spacing="12">
                    <Button Clicked="OnOpretDagsprojektClicked"
                            Text="Opret dagsprojekt"
                            BackgroundColor="{StaticResource HornebyOliveGreen}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="42"
                            WidthRequest="180" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>