<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaekApp.Views.OpretDagsprojektPage"
    Title="Opret dagsprojekt">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Opret dagsprojekt"
                FontSize="28"
                FontAttributes="Bold" />

            <Label Text="Adresse" />
            <Entry
                x:Name="AdresseEntry"
                Placeholder="Indtast projektets adresse" />

            <Label Text="Status" />
            <Entry
                x:Name="StatusEntry"
                Text="Fremtidigt projekt"
                Placeholder="Indtast status" />

            <Label Text="Forventet varighed i timer" />
            <Entry
                x:Name="VarighedEntry"
                Placeholder="Indtast antal timer"
                Keyboard="Numeric" />

            <Label Text="Tagareal i m²" />
            <Entry
                x:Name="TagarealEntry"
                Placeholder="Indtast tagareal"
                Keyboard="Numeric" />

            <Label Text="Startdato" />
            <DatePicker x:Name="StartdatoPicker" />

            <Label Text="Slutdato" />
            <DatePicker x:Name="SlutdatoPicker" />

            <Button
                Text="Opret dagsprojekt"
                Clicked="OnOpretDagsprojektClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>