<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaekApp.newProject"
             Title="newProject">
    <VerticalStackLayout>
        
        <Label 
            Text="ProjektID"
            VerticalOptions="Start" 
            HorizontalOptions="Start" />
        <Entry Placeholder="Tilføj projektID" 
               Keyboard="Numeric"/>

        <Label 
            Text="KundeID"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry Placeholder="Tilføj kundeID"
               Keyboard="Numeric"/>

        <Label 
            Text="Medarbejdere"
            VerticalOptions="Start" 
            HorizontalOptions="Start" />
            
        <Label
            Text="Adresse"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry Placeholder="Tilføj adresse" />
        
         <Label
            Text="Status"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
          <Entry Placeholder="Tilføj status" />
            
         <Label
            Text="Forventet Varighed Timer"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
          <Entry Placeholder="Tilføj varighed Timer"
                 Keyboard="Numeric"/>
            
          <Label
            Text="Kvadratmeter af tag"
            VerticalOptions="Start"
            HorizontalOptions="Start"/>
            <Entry Placeholder="Tilføj varighed Timer"
                   Keyboard="Numeric"/>
            
            
        <Button
            Text="Opret projekt"
            VerticalOptions="Start"
            HorizontalOptions="Start" /> 
            
    </VerticalStackLayout>
    
</ContentPage>