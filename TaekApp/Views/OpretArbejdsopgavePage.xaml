<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaekApp.Views.OpretArbejdsopgavePage"
             Title="Opret en standard arbejdsopgave">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Navn" />
            <Entry x:Name="txtNavn"
                   Placeholder="Tilføj navn" />

            <Label Text="Beskrivelse" />
            <Entry x:Name="txtBeskrivelse"
                   Placeholder="Tilføj beskrivelse" />

            <Label Text="Enhed (fx m², meter eller stk.)" />
            <Entry x:Name="txtEnhed"
                   Placeholder="Tilføj enhed" />

            <Label Text="Svendens produktion pr. dag" />
            <Entry x:Name="txtSvendProduktion"
                   Keyboard="Numeric"
                   Placeholder="Tilføj produktion" />

            <Label Text="Lærlingens produktion pr. dag" />
            <Entry x:Name="txtLaerlingProduktion"
                   Keyboard="Numeric"
                   Placeholder="Tilføj produktion" />

            <Button Text="Opret arbejdsopgave"
                    Clicked="OnOpretArbejdsopgaveClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
