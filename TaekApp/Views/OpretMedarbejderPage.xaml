<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaekApp.newProject"
             Title="Opret Medarbejder">
    <VerticalStackLayout>

        <Label 
            Text="ID"
            VerticalOptions="Start" 
            HorizontalOptions="Start" />
        <Entry Placeholder="Tilføj projektID" 
               Keyboard="Numeric"
               WidthRequest="200"/>

        <Label 
            Text="Navn"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry Placeholder="Tilføj navn" />

        <Label 
            Text="Admin"
            VerticalOptions="Start" 
            HorizontalOptions="Start" />
        <CheckBox IsChecked="False" />

        <Label
            Text="Telefonnummer"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry Placeholder="Tilføj adresse"
               WidthRequest="200"
               Keyboard="Telephone"/>

        <Label
            Text="Mail"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry Placeholder="Tilføj mail" 
                 WidthRequest="200"
               Keyboard="Email"/>

        <Label
            Text="Lærling"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <CheckBox IsChecked="False" />
        
        
        <Button
            Text="Opret"
            VerticalOptions="Start"
            HorizontalOptions="Start"
            WidthRequest="200" />

    </VerticalStackLayout>

</ContentPage>