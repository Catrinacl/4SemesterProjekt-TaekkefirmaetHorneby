<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaekApp.Views.OpretMedarbejderPage"
             Title="Opret Medarbejder">
    <VerticalStackLayout>

        <Label 
            Text="ID"
            VerticalOptions="Start" 
            HorizontalOptions="Start" />
        <Entry Placeholder="Tilføj ID"
               x:Name="idIndtast"
               Keyboard="Numeric"
               WidthRequest="200"/>

        <Label
            Text="Navn på medarbejder"
            VerticalOptions="Start"
            HorizontalOptions="Start" />

        <Entry
            x:Name="medarbejderIndtast"
            Placeholder="Tilføj navn på medarbejder"
            WidthRequest="200" />

        <Label 
            Text="Admin"
            VerticalOptions="Start" 
            HorizontalOptions="Start" />
        <CheckBox IsChecked="False"
                  WidthRequest="200" />

        <Label
            Text="Telefonnummer"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry x:Name="telefonNrIndtast" 
               Placeholder="Tilføj telefonnummer"
               WidthRequest="200" />

        <Label
            Text="Mail"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry x:Name= "mailIndtast" 
               Placeholder="Tilføj mail" 
               WidthRequest="200" />

        <Label
            Text="Lærling"
            VerticalOptions="Start"
            HorizontalOptions="Start" />
        <Entry x:Name="isLæring"/>
        <CheckBox IsChecked="False" 
                  WidthRequest="200" />

        <Button
            Text="Opret"
            Clicked="Button_Clicked"
            VerticalOptions="Start"
            HorizontalOptions="Start"
            WidthRequest="200" />

    </VerticalStackLayout>
    
</ContentPage>